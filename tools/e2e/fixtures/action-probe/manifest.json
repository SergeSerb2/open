{
  "manifest_version": 3,
  "name": "Open action probe",
  "version": "1.0",
  "description": "End-to-end probe for toolbar actions and popups (tools/e2e/engine_e2e.py --only actions).",
  "permissions": [
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Action probe",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "key": "",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      }
    },
    "probe-named": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Run the probe command"
    }
  },
  "optional_permissions": [
    "downloads"
  ],
  "omnibox": {
    "keyword": "probe"
  }
}
