import("//build/rust/rust_static_library.gni")

# CXX bridge over the vendored Brave adblock crate (MPL-2.0).
# See docs/plans/adblock-fork.md §5. The only Rust Open writes by hand.
rust_static_library("open_adblock_rust") {
  # CXX generated code; the shim itself has no unsafe blocks.
  allow_unsafe = true
  crate_root = "src/lib.rs"
  sources = [ "src/lib.rs" ]
  cxx_bindings = [ "src/lib.rs" ]
  deps = [
    ":domain_resolver",
    "//third_party/rust/adblock/v0_8:lib",
    "//third_party/rust/serde_json/v1:lib",
  ]
  visibility = [
    "//open:*",
    "//open/adblock:*",
  ]
}

# This leaf has no dependency on the Rust shim, so the CXX callback does not
# create a circular GN dependency.
source_set("domain_resolver") {
  sources = [ "domain_resolver.cc", "domain_resolver.h" ]
  deps = [ "//build/rust:cxx_cppdeps", "//net" ]
}
