# Open's native ad blocking (docs/plans/adblock-fork.md §6, §7). libcef_static
# depends on this target (CEF patch 0310); it must not depend on //cef, so the
# hooks of patch 0311 find their service through the BrowserContext.
source_set("adblock") {
  sources = [
    "open_adblock_engine_registry.cc",
    "open_adblock_engine_registry.h",
    "open_adblock_hooks.cc",
    "open_adblock_hooks.h",
    "open_adblock_matcher.cc",
    "open_adblock_matcher.h",
    "open_adblock_service.cc",
    "open_adblock_service.h",
    "open_adblock_socket_hooks.h",
    "open_adblock_tab_helper.cc",
    "open_adblock_tab_helper.h",
    "open_adblock_types.h",
    "open_adblock_url_loader_factory.cc",
    "open_adblock_url_loader_factory.h",
  ]

  # The --open-adblock-selftest mode is for development builds only: patch
  # 0310 reads its switches only without OFFICIAL_BUILD (review 100-3).
  if (!is_official_build) {
    sources += [
      "open_adblock_selftest.cc",
      "open_adblock_selftest.h",
      "open_adblock_profile_proof.h",
    ]
    deps = [
      "//base/allocator/partition_allocator/src/partition_alloc:allocator_shim",
    ]
  } else {
    deps = []
  }
  deps += [
    "//base",
    "//base/allocator/partition_allocator/src/partition_alloc",
    "//content/public/browser",
    "//crypto",
    "//mojo/public/cpp/bindings",
    "//mojo/public/cpp/system",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//url",
  ]
  # The service header includes the CXX header generated by the shim.
  public_deps = [ "//open/adblock/rust:open_adblock_rust" ]
  visibility = [
    "//cef/*",
    "//open/*",
  ]
}
