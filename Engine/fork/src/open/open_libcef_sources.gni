# Open GN targets libcef_static links (also wired in by patch 0302).
open_libcef_deps = [
  "//chrome/browser/ssl",
  # Context-scoped renderer MemoryCache invalidation at next navigation.
  "//components/web_cache/browser",
  # Native ad blocking: the per-Profile service (docs/plans/adblock-fork.md).
  "//open/adblock",
  "//open/adblock/renderer",

  # Tab sleeping: navigation history capture and restore with Chromium's
  # session serializer (docs/plans/memory-fork.md §5.3).
  "//components/sessions",

  # Page selection link (CefRequestSelection): text-fragment directives
  # (docs/plans/page-platform.md EP-2).
  "//components/shared_highlighting/core/common",
]

# Headless native Profile/OTR receipt path; absent in official builds.
if (!is_official_build) {
  open_libcef_mac_sources += [
    "//open/adblock/open_adblock_profile_proof.cc",
    "//open/adblock/open_adblock_api_proof.cc",
  ]
}
