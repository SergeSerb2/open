# Open engine sources compiled into CEF's libcef_static target (macOS block),
# wired in by Engine/fork/patches/cef/0302-open-hosted-tabs.patch. They get
# libcef's configs and deps, so they may include cef/libcef and chrome headers.
open_libcef_mac_sources = [
  "//open/browser/tab_strip/hidden_browser.h",
  "//open/browser/tab_strip/open_browser_window.h",
  "//open/browser/tab_strip/open_browser_window.mm",
  "//open/browser/tab_strip/open_hosted_platform_delegate.h",
  "//open/browser/tab_strip/open_hosted_platform_delegate.mm",
  "//open/browser/tab_strip/open_tab_strip.cc",
  "//open/browser/tab_strip/open_tab_strip.h",
]

# Open GN targets libcef_static links (also wired in by patch 0302).
open_libcef_deps = [
  # Native ad blocking: the per-Profile service (docs/plans/adblock-fork.md).
  "//open/adblock",
]
