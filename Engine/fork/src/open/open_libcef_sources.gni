  "//open/browser/extensions/open_extension_manager.mm",
  "//open/browser/extensions/open_extension_hooks.h",
  "//open/browser/extensions/open_extension_popup.cc",
  "//open/browser/extensions/open_extension_popup.h",
  "//open/browser/extensions/open_extensions_toolbar.cc",
  "//open/browser/extensions/open_extensions_toolbar.h",
  "//open/browser/media/open_media_controller.cc",
  "//open/browser/media/open_media_controller.h",
  "//open/browser/media/open_media_hooks.h",
  "//open/browser/media/open_video_overlay_window.h",
  "//open/browser/media/open_video_overlay_window.mm",
  "//open/browser/memory/open_navigation_history.cc",
  "//open/browser/memory/open_navigation_history.h",
  "//open/browser/memory/open_page_lifecycle.cc",
  "//open/browser/page/open_history_swipe_hooks.h",
  "//open/browser/page/open_browser_info.cc",
