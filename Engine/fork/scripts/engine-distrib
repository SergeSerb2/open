#!/bin/bash
# Target shell: /bin/bash 3.2 (macOS). Guard empty arrays under set -u.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/common.sh
. "$SCRIPT_DIR/lib/common.sh"
usage() {
    cat <<'EOF'
engine-distrib [--config dev|release] [--skip-build] [--dry-run] [--run]
No arguments: show help. Use --run for the default dev distribution.
Engine/fork/scripts/engine-distrib --run
EOF
}
[[ $# -gt 0 ]] || { usage; exit 0; }
config=dev skip=0 dry=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h) usage; exit 0 ;;
        --run) shift ;;
        --config) [[ $# -ge 2 ]] || die '--config needs a value'; config=$2; shift 2 ;;
        --skip-build) skip=1; shift ;;
        --dry-run) dry=1; shift ;;
        *) die "unknown option: $1" ;;
    esac
done
case "$config" in dev) out=$OUT_DIR_DEV ;; release) out=$OUT_DIR_RELEASE ;; *) die "invalid config: $config" ;; esac
if [[ "$config" == release ]]; then
    die "release packaging not wired yet: CEF's make_distrib expects out/Release_GN_arm64; see docs/plans/fork-infra.md Step 10"
fi
if [[ $dry == 1 ]]; then
    log "dry-run: would engine-build --config $config --target \"cefsimple cefclient\" (skip-build=$skip)"
    log "dry-run: (cd $SRC_DIR/cef/tools && python3 make_distrib.py --output-dir=$SRC_DIR/cef/binary_distrib --allow-partial --ninja-build --arm64-build --minimal --no-symbols --no-docs --no-archive)"
    log "dry-run: would discover one updated child in $SRC_DIR/cef/binary_distrib and write $STATE_DIR/distrib.txt"
    exit 0
fi
require_no_build_running
acquire_lock distrib
# CEF's make_distrib.py copies the framework out of cefclient.app
# (cef/tools/make_distrib.py: framework_src_dir under cefclient_app). Without
# cefclient the distribution has headers and wrapper sources but no Release/.
[[ $skip == 1 ]] || "$SCRIPT_DIR/engine-build" --config "$config" --target "cefsimple cefclient"
[[ -d "$SRC_DIR/$out/cefclient.app" ]] || die "missing $SRC_DIR/$out/cefclient.app; build it first (engine-build --target \"cefsimple cefclient\")"
require_no_build_running
export_engine_env
[[ -f "$SRC_DIR/cef/tools/make_distrib.py" ]] || die "missing $SRC_DIR/cef/tools/make_distrib.py"
# make_distrib hard-codes out/Release_GN_arm64 as its input. It has no option
# for the separate official output directory (see the release gate above).
snapshot() {
    python3 - "$1" <<'PY'
import json, pathlib, sys
base = pathlib.Path(sys.argv[1])
result = {}
if base.is_dir():
    for child in sorted(base.iterdir()):
        if child.is_dir() or child.name.endswith('.tar.bz2'):
            files = [child] + (list(child.rglob('*')) if child.is_dir() else [])
            result[str(child)] = [(str(f.relative_to(base)), f.stat().st_size, f.stat().st_mtime_ns) for f in sorted(files) if f.is_file()]
print(json.dumps(result, sort_keys=True))
PY
}
fingerprint=$(python3 - "$SRC_DIR/$out" "$CHROMIUM_COMMIT" "$CEF_COMMIT" <<'PY'
import hashlib, pathlib, sys
out = pathlib.Path(sys.argv[1])
files = [out/'cefsimple.app/Contents/MacOS/cefsimple', out/'cefclient.app/Contents/Frameworks/Chromium Embedded Framework.framework/Versions/A/Chromium Embedded Framework'] + sorted(out.glob('Chromium Embedded Framework.framework/Chromium Embedded Framework'))
if not any(p.is_file() for p in files[1:]):
    raise SystemExit('no built framework; run engine-build first')
print(hashlib.sha256(repr((sys.argv[2:], [(str(p), p.stat().st_size, p.stat().st_mtime_ns) for p in files if p.is_file()])).encode()).hexdigest())
PY
)
stamp="$STATE_DIR/distrib-$config.done"
if [[ -f "$stamp" && "$(cat "$stamp")" == "$fingerprint" && -f "$STATE_DIR/distrib.txt" && -e "$(cat "$STATE_DIR/distrib.txt")" ]]; then
    log "already up to date: $(cat "$STATE_DIR/distrib.txt")"
    exit 0
fi
before=$(snapshot "$SRC_DIR/cef/binary_distrib")
# Call CEF's packager directly, as automate-git.py --minimal-distrib-only
# does, plus --no-symbols: on this branch automate never passes it for the
# minimal type, so make_distrib copies dSYMs, which only official builds or
# enable_dsyms=true produce (dev builds fail with a missing .dSYM). The app
# uses the directory, so skip the slow tar.bz2 archive.
(cd "$SRC_DIR/cef/tools" && python3 make_distrib.py \
    --output-dir="$SRC_DIR/cef/binary_distrib" --allow-partial --ninja-build \
    --arm64-build --minimal --no-symbols --no-docs --no-archive)
after=$(snapshot "$SRC_DIR/cef/binary_distrib")
chosen=$(python3 - "$before" "$after" <<'PY'
import json, pathlib, sys
before, after = map(json.loads, sys.argv[1:])
changed = [p for p in after if before.get(p) != after[p]]
# A directory and its archive represent the same distribution. Prefer the directory.
dirs = [p for p in changed if pathlib.Path(p).is_dir()]
candidates = dirs or changed
if len(candidates) != 1:
    raise SystemExit('expected exactly one updated distrib candidate: ' + repr(candidates))
print(pathlib.Path(candidates[0]).resolve())
PY
) || die 'distribution discovery failed; inspect binary_distrib candidates'
printf '%s\n' "$chosen" > "$STATE_DIR/distrib.txt.tmp"
mv "$STATE_DIR/distrib.txt.tmp" "$STATE_DIR/distrib.txt"
printf '%s\n' "$fingerprint" > "$stamp"
du -sh "$chosen"
if [[ -d "$chosen" ]]; then ls "$chosen"; else tar -tjf "$chosen"; fi
log "distribution: $chosen"
