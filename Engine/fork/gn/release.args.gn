# Release overrides appended after dev.args.gn.
# Phase 2 requires the exact revision-matching profile; engine-build guards it.
# Keep generated args and dSYMs with the build receipt.
is_official_build = true
is_debug = false
is_component_build = false
dcheck_always_on = false
enable_iterator_debugging = false
symbol_level = 1
blink_symbol_level = 0
v8_symbol_level = 0
enable_dsyms = true
enable_stripping = true
use_lld = true
use_thin_lto = true
thin_lto_enable_optimizations = true
chrome_pgo_phase = 2
# Resolve chrome/build/mac-arm.pgo.txt through Chromium's PGO configuration.
# Do not substitute a profile from a different Chromium revision.
target_cpu = "arm64"
treat_warnings_as_errors = false
proprietary_codecs = true
ffmpeg_branding = "Chrome"
# Widevine remains disabled until a license permits distribution.
enable_widevine = false
v8_enable_debugging_features = false
v8_enable_pointer_compression = true
v8_enable_pointer_compression_shared_cage = true
v8_enable_sandbox = true
v8_enable_maglev = true
v8_enable_turbofan = true
is_asan = false
is_msan = false
is_tsan = false
is_ubsan = false
use_siso = true
use_remoteexec = false
