+void BookmarkStorage::SaveNowAndStop(base::OnceClosure done) {
   SaveNowIfScheduled();
+  stopped_ = true;
+  // The backup task and every write run on `backend_task_runner_` in order, so
+  // the reply runs after the last of them.
+  backend_task_runner_->PostTaskAndReply(FROM_HERE, base::DoNothing(),
+                                         std::move(done));
