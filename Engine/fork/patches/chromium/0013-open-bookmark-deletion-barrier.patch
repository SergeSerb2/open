+void BookmarkModel::FlushAndStopWritesForProfileDeletion(
+    base::OnceClosure done) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  base::RepeatingClosure barrier = base::BarrierClosure(2, std::move(done));
+  for (BookmarkStorage* store :
+       {local_or_syncable_store_.get(), account_store_.get()}) {
+    if (store) {
+      store->SaveNowAndStop(barrier);
+    } else {
+      barrier.Run();
+    }
+  }
+}
