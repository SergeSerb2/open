 ExtensionInstallPrompt::ShowDialogCallback
 ExtensionInstallPrompt::GetDefaultShowDialogCallback() {
-  return base::BindRepeating(&ShowExtensionInstallDialogImpl);
+  return base::BindRepeating([](
+      std::unique_ptr<ExtensionInstallPromptShowParams> params,
+      DoneCallback done,
+      std::unique_ptr<extensions::InstallPromptData> prompt) {
+    auto hook = open_engine::GetExtensionHooks().show_install;
+    if (hook && hook(params, done, prompt)) {
+      return;
+    }
+    ShowExtensionInstallDialogImpl(std::move(params), std::move(done),
+                                  std::move(prompt));
+  });
 }
