+void MediaSessionImpl::SetOpenVolumeMultiplier(double multiplier) {
+  multiplier = std::isfinite(multiplier) ? std::clamp(multiplier, 0.0, 1.0)
+                                         : 1.0;
+  if (multiplier == open_volume_multiplier_) {
+    return;
+  }
+  open_volume_multiplier_ = multiplier;
+  UpdateVolumeMultiplier();
+}
