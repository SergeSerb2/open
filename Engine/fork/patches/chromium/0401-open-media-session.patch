+bool MediaSessionControllersManager::OpenIsPictureInPictureAvailable(
+    const MediaPlayerId& id) const {
+  auto it = controllers_map_.find(id);
+  if (it == controllers_map_.end()) {
+    return false;
+  }
+  const MediaSessionController& controller = *it->second;
+  return controller.IsPictureInPictureAvailable(
+      controller.get_player_id_for_testing());
+}
