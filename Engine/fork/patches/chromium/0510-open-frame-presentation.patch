+void WidgetBase::RequestOpenFramePresentation(
+    uint64_t request_id, const gfx::Size& viewport_pixels, float scale,
+    RequestOpenFramePresentationCallback callback) {
+  CancelOpenFramePresentation(open_frame_request_id_);
+  if (is_hidden_ || viewport_pixels.IsEmpty() || !std::isfinite(scale) ||
+      scale <= 0 || !request_id) {
+    std::move(callback).Run(base::TimeTicks());
+    return;
+  }
+  open_frame_request_id_ = request_id;
+  ++open_frame_epoch_;
+  open_frame_viewport_pixels_ = viewport_pixels;
+  open_frame_scale_ = scale;
+  open_frame_callback_ = std::move(callback);
+  MaybeArmOpenFramePresentation();
+}
+
+void WidgetBase::CancelOpenFramePresentation(uint64_t request_id) {
+  if (request_id != open_frame_request_id_ || !open_frame_callback_)
+    return;
+  ++open_frame_epoch_;
+  open_frame_armed_ = false;
+  auto callback = std::move(open_frame_callback_);
+  std::move(callback).Run(base::TimeTicks());
+}
+
+void WidgetBase::MaybeArmOpenFramePresentation() {
+  if (!open_frame_callback_)
+    return;
+  const bool matches =
+      CompositorViewportRect().size() == open_frame_viewport_pixels_ &&
+      LayerTreeHost()->device_scale_factor() == open_frame_scale_;
+  if (open_frame_armed_) {
+    if (!matches || open_frame_surface_ != local_surface_id_from_parent_)
+      CancelOpenFramePresentation(open_frame_request_id_);
+    return;
+  }
+  if (!matches || !local_surface_id_from_parent_.is_valid())
+    return;  // Armed before resize: wait for its actual visual properties.
+  open_frame_surface_ = local_surface_id_from_parent_;
+  open_frame_armed_ = true;
+  LayerTreeHost()->RequestSuccessfulPresentationTimeForNextFrame(
+      base::BindOnce(&WidgetBase::DidPresentOpenFrame,
+                     weak_ptr_factory_.GetWeakPtr(), open_frame_epoch_));
+  // Static pages also need a qualifying frame. This does not treat a
+  // redraw ACK or commit/activation as presentation.
+  LayerTreeHost()->SetNeedsCommitWithForcedRedraw();
+}
+
+void WidgetBase::DidPresentOpenFrame(
+    uint64_t epoch, const viz::FrameTimingDetails& details) {
+  if (epoch != open_frame_epoch_ || !open_frame_callback_)
+    return;
+  if (is_hidden_ || !open_frame_armed_ ||
+      open_frame_surface_ != local_surface_id_from_parent_ ||
+      CompositorViewportRect().size() != open_frame_viewport_pixels_ ||
+      LayerTreeHost()->device_scale_factor() != open_frame_scale_) {
+    CancelOpenFramePresentation(open_frame_request_id_);
+    return;
+  }
+  open_frame_armed_ = false;
+  std::move(open_frame_callback_).Run(details.presentation_feedback.timestamp);
+}
