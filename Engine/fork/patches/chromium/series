# Open patches for Chromium. One patch per line: <file>.patch  # rationale
# Order in this file is apply order. See docs/plans/fork-infra.md §4.2.
0301-open-headless-browser-window.patch  # P1: Browser features without a BrowserView (hidden tab-strip Browsers)
0302-open-hidden-browser-ui.patch  # P1: Chrome UI code that assumes "no BrowserView => unit test" accepts hidden tab-strip Browsers
0303-open-hosted-tab-lifecycle.patch  # P1: hosted tabs are never discarded by Chrome's lifecycle unit; tab API guards moved to 0306
0304-open-hidden-browser-no-tab-groups.patch  # P1: hidden Browsers have no tab group model (folders are not tab groups)
0305-open-extension-prompts.patch  # P3 install and uninstall consent; keep platform dialogs without a handler
0306-open-extension-windows-tabs.patch  # E11 extension windows and hosted tab API guards (moved from 0303)
0401-open-media-session.patch  # Media (media-pip EM-2, EM-5): tab volume multiplier in MediaSessionImpl; per-player Picture-in-Picture availability getter, so browser-initiated PiP respects disablePictureInPicture
0402-open-video-pip-window.patch  # Media EM-4 (media-pip §6): CreateVideoOverlayWindow asks Open first (open/browser/media/open_media_hooks.h); Open's window when the page's media handler hosts video Picture in Picture, else Chromium's VideoOverlayWindowViews
0403-open-document-pip-window.patch  # Media EM-7 (media-pip §6): Navigate() hands a Document Picture-in-Picture child to Open first (open/browser/media/open_media_hooks.h); Open's panel when the opener's media handler hosts Picture in Picture, else Chromium's own window
0501-page-history-swipe-hooks.patch  # Page platform EP-1: Chromium's history swipe overlay reports its phases to the page handler and can stay hidden (open/browser/page/open_history_swipe_hooks.h); page-platform §6
0504-page-notification-click.patch  # Page platform EP-6: a web notification click reaches the embedder's handler before Chromium dispatches it (open/browser/page/open_notification_hooks.h); page-platform §6
0506-page-automation-notification-guard.patch  # Automation: skip native macOS dispatchers before they force-start the Alerts provider; normal launches unchanged
0801-open-password-prompt-routing.patch  # H-1: route password prompts to Open
0802-open-address-bubble-handler-lookup.patch  # H-3: find address handlers without a BrowserView
0803-open-autofill-page-routing.patch  # H-4: route Manage links to Open
0804-open-null-credential-dialogs.patch  # H-6: settle credential dialogs without Views windows
0805-open-autofill-defaults.patch  # Fill on select; no autosignin/leak prompts; card reauth on without opt-in promo
0806-open-https-fallback-dialog-host.patch  # Use the native modal host for HTTPS fallback; cancel when detached
0807-open-hosted-autofill-popup.patch
0808-open-hosted-modal-dialog.patch  # H-7: attach and position Views web-modal dialogs in their AppKit parent
0809-open-https-warning-after-commit.patch  # H-7: defer hosted HTTPS warning beyond its triggering commit; cancel stale shows
0810-open-modal-unblock-during-tab-teardown.patch  # H-7: keep modal unblock state but omit UI events after tab features are destroyed
0601-open-script-world.patch  # P7: reserve Open world; keep queued frame actions in the main context
