+bool WebCacheManager::ClearCacheForProcessOnNavigation(
+    content::ChildProcessId process_id) {
+  auto it = web_cache_services_.find(process_id);
+  auto* process = content::RenderProcessHost::FromID(process_id);
+  if (it == web_cache_services_.end() || !process || !process->IsReady()) {
+    return false;
+  }
+  it->second->ClearCache(true);
+  return true;
+}
