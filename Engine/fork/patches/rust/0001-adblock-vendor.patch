+    /// assert_eq!(tv.swap_remove(0), "foo");
+    /// assert_eq!(tv.as_slice(), &["quack", "zap"][..]);
+    /// ```
+    #[inline]
+    pub fn swap_remove(self: &mut Self, index: usize) -> A::Item;
+
