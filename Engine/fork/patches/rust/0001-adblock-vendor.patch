+
+        // inserts into empty
+        insert_dup(&mut dup_map, 1, String::from("foo"));
+        assert_eq!(dup_map.get(&1), Some(&vec![String::from("foo")]));
+
+        // adds item
+        insert_dup(&mut dup_map, 1, String::from("bar"));
+        assert_eq!(
+            dup_map.get(&1),
+            Some(&vec![String::from("bar"), String::from("foo")])
+        );
