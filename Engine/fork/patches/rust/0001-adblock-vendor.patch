+
+def escape_char(c):
+    return "\\u{%x}" % ord(c[0])
+
+def char(s):
+    return chr(int(s, 16))
+
+strtab = collections.OrderedDict()
+strtab_offset = 0
+
+def strtab_slice(s):
+    global strtab, strtab_offset
+
+    if s in strtab:
+        return strtab[s]
+    else:
+        utf8_len = len(s.encode('utf8'))
+        c = (strtab_offset, utf8_len)
+        strtab[s] = c
+        strtab_offset += utf8_len
+        return c
+
