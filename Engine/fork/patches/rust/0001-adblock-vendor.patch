+    fn take_after_path(&mut self) -> String {
+        match (self.query_start, self.fragment_start) {
+            (Some(i), _) | (None, Some(i)) => {
+                let after_path = self.slice(i..).to_owned();
+                self.serialization.truncate(i as usize);
+                after_path
+            }
+            (None, None) => String::new(),
+        }
+    }
