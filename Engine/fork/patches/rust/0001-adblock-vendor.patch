+    R: RmpRead,
+{
+    match read_marker(rd)? {
+        Marker::FixArray(size) => Ok(size as u32),
+        Marker::Array16 => Ok(rd.read_data_u16()? as u32),
+        Marker::Array32 => Ok(rd.read_data_u32()?),
+        marker => Err(ValueReadError::TypeMismatch(marker)),
+    }
+}
