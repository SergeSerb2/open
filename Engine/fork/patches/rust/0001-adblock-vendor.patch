+        // inserts into another key item
+        insert_dup(&mut dup_map, 123, String::from("baz"));
+        assert_eq!(dup_map.get(&123), Some(&vec![String::from("baz")]));
+        assert_eq!(
+            dup_map.get(&1),
+            Some(&vec![String::from("bar"), String::from("foo")])
+        );
