+  /// sv.push(11);
+  /// assert_eq!(sv.grab_spare_slice_mut().len(), 2);
+  /// ```
+  #[inline(always)]
+  pub fn grab_spare_slice_mut(&mut self) -> &mut [T] {
+    &mut self.data[self.len..]
+  }
+}
