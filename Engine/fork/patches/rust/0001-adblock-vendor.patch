diff --git a/third_party/rust/chromium_crates_io/gnrt_config.toml.open b/third_party/rust/chromium_crates_io/gnrt_config.toml.open
new file mode 100644
index 0000000000000..8989a555e6581
--- /dev/null
+++ b/third_party/rust/chromium_crates_io/gnrt_config.toml.open
@@ -0,0 +1,38 @@
+# Open fragment. Merged into gnrt_config.toml by the Rust step (fork-infra
+# §7.4). gnrt vendor also writes its own [crate.X] allow_unsafe entries for
+# the new crates; those are tool output, captured in
+# patches/rust/0001-adblock-vendor.patch, and not repeated here.
+# Lead decisions 2026-10-26: docs/engine-patches.md "Security review".
+
+# Chromium: group = 'test' (imported only for libafl). adblock needs regex
+# in the browser process. Built without perf-literal (crate patches
+# adblock-v0_8 and libafl-v0_15; review 97-1 keeps the other perf engines),
+# so aho-corasick keeps Chromium's allow_unsafe = false and leaves the build.
+[crate.regex]
+group = 'safe'
+allow_first_party_usage = false
+extra_kv = { allow_unsafe = true }
+
+# Two epochs now: thiserror 1 (adblock) and 2 (Chromium). Only 2 has the
+# generated private.rs.
+[crate."thiserror@v1"]
+extra_kv = { allow_unsafe = false }
+
+[crate."thiserror@v2"]
+build_script_outputs = [ "private.rs" ]
+extra_kv = { allow_unsafe = false }
+
+# Two epochs: idna 0.2 (adblock, no unsafe) and 1 (url 2.5, uses unsafe).
+[crate."idna@v0_2"]
+extra_kv = { allow_unsafe = false }
+
+[crate."idna@v1"]
+extra_kv = { allow_unsafe = true }
+
+# Two epochs: itertools 0.10 (adblock, no unsafe; review 97-3) and 0.14
+# (Chromium).
+[crate."itertools@v0_10"]
+extra_kv = { allow_unsafe = false }
+
+[crate."itertools@v0_14"]
+extra_kv = { allow_unsafe = true }
diff --git a/third_party/rust/chromium_crates_io/patches/adblock-v0_8/0001-Use-regex-without-perf-features.patch b/third_party/rust/chromium_crates_io/patches/adblock-v0_8/0001-Use-regex-without-perf-features.patch
new file mode 100644
index 0000000000000..d9db75f67f4bc
--- /dev/null
+++ b/third_party/rust/chromium_crates_io/patches/adblock-v0_8/0001-Use-regex-without-perf-features.patch
@@ -0,0 +1,31 @@
+From: Open engine <noreply@open.invalid>
+Subject: [PATCH] Use regex without perf-literal (no aho-corasick)
+
+Open builds regex with default-features = false: std, unicode, and the
+regex-automata engines (perf-dfa, perf-onepass, perf-backtrack, perf-cache,
+perf-inline), but not perf-literal, so aho-corasick's SIMD (unsafe) code
+stays out of the build (lead decisions 2026-10-26, review 97-1;
+docs/engine-patches.md "Security review").
+
+---
+diff --git a/third_party/rust/chromium_crates_io/vendor/adblock-v0_8/Cargo.toml b/third_party/rust/chromium_crates_io/vendor/adblock-v0_8/Cargo.toml
+index 064da8ae0db1f..f44cd1e95bb83 100644
+--- a/third_party/rust/chromium_crates_io/vendor/adblock-v0_8/Cargo.toml
++++ b/third_party/rust/chromium_crates_io/vendor/adblock-v0_8/Cargo.toml
+@@ -94,6 +94,16 @@ version = "2.1"
+ 
+ [dependencies.regex]
+ version = "1.5"
++default-features = false
++features = [
++    "perf-backtrack",
++    "perf-cache",
++    "perf-dfa",
++    "perf-inline",
++    "perf-onepass",
++    "std",
++    "unicode",
++]
+ 
+ [dependencies.rmp-serde]
+ version = "0.15"
diff --git a/third_party/rust/chromium_crates_io/patches/adblock-v0_8/0002-Warm-network-regexes-before-publishing.patch b/third_party/rust/chromium_crates_io/patches/adblock-v0_8/0002-Warm-network-regexes-before-publishing.patch
new file mode 100644
index 0000000000000..9791a36843ff2
--- /dev/null
+++ b/third_party/rust/chromium_crates_io/patches/adblock-v0_8/0002-Warm-network-regexes-before-publishing.patch
@@ -0,0 +1,267 @@
+From: Open engine <noreply@open.invalid>
+Subject: [PATCH] Compile off-thread, use ASCII ABP forms, and restore DAT sharing
+
+Compile programs without matching; retain programs to avoid request-path
+recompiles. Keep the upstream regex builder defaults (cache and accelerators).
+Re-share exact immutable DAT rules before compiling.
+
+diff --git a/third_party/rust/chromium_crates_io/vendor/adblock-v0_8/src/blocker.rs b/third_party/rust/chromium_crates_io/vendor/adblock-v0_8/src/blocker.rs
+--- a/third_party/rust/chromium_crates_io/vendor/adblock-v0_8/src/blocker.rs
++++ b/third_party/rust/chromium_crates_io/vendor/adblock-v0_8/src/blocker.rs
+@@ -138,6 +138,34 @@
+     pub(crate) regex_manager: std::sync::Mutex<RegexManager>,
+ }
+
++// DAT serialization writes each Arc value independently. Re-share exact
++// immutable values after loading. Do not trust the serialized id as identity:
++// compare and hash every field (adblock 0.8.11); HashSet uses randomized hashing.
++struct ExactNetworkFilter(Arc<NetworkFilter>);
++impl PartialEq for ExactNetworkFilter {
++    fn eq(&self, other: &Self) -> bool {
++        let (a, b) = (&*self.0, &*other.0);
++        a.mask.bits() == b.mask.bits() && a.filter == b.filter &&
++        a.opt_domains == b.opt_domains && a.opt_not_domains == b.opt_not_domains &&
++        a.modifier_option == b.modifier_option && a.hostname == b.hostname &&
++        a.tag == b.tag && a.raw_line == b.raw_line && a.id == b.id &&
++        a.opt_domains_union == b.opt_domains_union &&
++        a.opt_not_domains_union == b.opt_not_domains_union
++    }
++}
