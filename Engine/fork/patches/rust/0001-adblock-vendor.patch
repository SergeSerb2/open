+        Ok(RawRef { s })
+    }
+}
+
+impl<'de> Deserialize<'de> for RawRef<'de> {
+    #[inline]
+    fn deserialize<D>(de: D) -> Result<Self, D::Error>
+        where D: de::Deserializer<'de>
+    {
+        de.deserialize_any(RawRefVisitor)
+    }
+}
