+            // Obscure edge cases that break most parsers:
+            ("https://example.com/?fbclid&foo&&gclid=2&bar=&%20",
+             "https://example.com/?fbclid&foo&&bar=&%20"),
+            ("https://example.com/?fbclid=1&1==2&=msclkid&foo=bar&&a=b=c&",
