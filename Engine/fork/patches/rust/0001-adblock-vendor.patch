+    }
+
+    let dog1 = Dog1 {
+        name: "Frankie".into(),
+        age: 42,
+    };
+
+    let serialized: Vec<u8> = to_vec_named(&dog1).unwrap();
+    let deserialized: Dog2 = from_slice(&serialized).unwrap();
+
+    let check = Dog1 {
+        age: deserialized.age,
+        name: deserialized.name,
+    };
