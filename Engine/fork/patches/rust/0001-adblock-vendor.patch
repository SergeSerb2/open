+  pub fn move_to_the_heap_and_reserve(&mut self, n: usize) {
+    let arr = match self {
+      TinyVec::Heap(h) => return h.reserve(n),
+      TinyVec::Inline(a) => a,
+    };
+
+    let v = arr.drain_to_vec_and_reserve(n);
+    *self = TinyVec::Heap(v);
+  }
