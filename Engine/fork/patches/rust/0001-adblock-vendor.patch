+    #[inline(always)]
+    $v fn $fname($seif : $seifty, $($argname: $argtype),*) $(-> $ret)? {
+      match $seif {
+        $tinyname::Inline(i) => i.$fname($($argname),*),
+        $tinyname::Heap(h) => h.$fname($($argname),*),
