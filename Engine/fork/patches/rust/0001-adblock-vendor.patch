+            "data/uBlockOrigin/unbreak.txt",
+        ]);
+        let (_, cosmetic_filters) = parse_filters(&rules, false, FilterFormat::Standard);
+        let cfcache = CosmeticFilterCache::from_rules(cosmetic_filters);
+        let exceptions = Default::default();
