+macro_rules! impl_mirrored {
+  {
+  type Mirror = $tinyname:ident;
+  $(
+    $(#[$attr:meta])*
+    $v:vis fn $fname:ident ($seif:ident : $seifty:ty $(,$argname:ident : $argtype:ty)*) $(-> $ret:ty)? ;
+  )*
+  } => {
+    $(
