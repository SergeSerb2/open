+        write!(f, ",{}", if f.alternate() { "\n    " } else { " " })?;
+      }
+      Pointer::fmt(elem, f)?;
+    }
+    if f.alternate() {
+      write!(f, ",\n")?;
+    }
+    write!(f, "]")
+  }
