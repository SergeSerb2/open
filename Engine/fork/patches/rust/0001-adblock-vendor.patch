+    let mut de = CustomDeserializer { inner: Deserializer::new(cur) };
+    let actual: Enum = Deserialize::deserialize(&mut de).unwrap();
+
+    assert_eq!(Enum::B, actual);
+    assert_eq!(2, de.inner.get_ref().position());
