+  #[inline(always)]
+  fn deref(&self) -> &Self::Target {
+    &self.data.as_slice()[..self.len as usize]
+  }
+}
+
+impl<A: Array> DerefMut for ArrayVec<A> {
+  #[inline(always)]
+  fn deref_mut(&mut self) -> &mut Self::Target {
+    &mut self.data.as_slice_mut()[..self.len as usize]
+  }
+}
