+/// successful read.
+pub fn read_i8<R: RmpRead>(rd: &mut R) -> Result<i8, ValueReadError<R::Error>> {
+    match read_marker(rd)? {
+        Marker::I8 => rd.read_data_i8(),
+        marker => Err(ValueReadError::TypeMismatch(marker)),
+    }
+}
