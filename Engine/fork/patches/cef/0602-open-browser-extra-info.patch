@@ -51,6 +51,26 @@ CefBrowserInfo::~CefBrowserInfo() {
   DCHECK(frame_info_set_.empty());
 }
 
+CefRefPtr<CefDictionaryValue> CefBrowserInfo::extra_info() const {
+  base::AutoLock lock_scope(lock_);
+  return extra_info_;
+}
+
+bool CefBrowserInfo::SetExtraInfo(CefRefPtr<CefDictionaryValue> extra_info) {
+  CEF_REQUIRE_UIT_RETURN(false);
+  auto copy = extra_info ? extra_info->Copy(/*exclude_empty_children=*/false)
+                         : nullptr;
+  if (extra_info && !copy) {
+    return false;
+  }
+  if (copy) {
+    static_cast<CefDictionaryValueImpl*>(copy.get())->MarkReadOnly();
+  }
+  base::AutoLock lock_scope(lock_);
+  extra_info_ = copy;
+  return true;
+}
+
