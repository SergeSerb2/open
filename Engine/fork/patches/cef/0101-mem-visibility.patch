 void AlloyBrowserHostImpl::WasHidden(bool hidden) {
-  if (!IsWindowless()) {
-    DCHECK(false) << "Window rendering is not disabled";
-    return;
-  }
-
   if (!CEF_CURRENTLY_ON_UIT()) {
     CEF_POST_TASK(CEF_UIT,
                   base::BindOnce(&CefBrowserHost::WasHidden, this, hidden));
     return;
   }
 
-  if (platform_delegate_) {
-    platform_delegate_->WasHidden(hidden);
+  if (IsWindowless()) {
+    if (platform_delegate_) {
+      platform_delegate_->WasHidden(hidden);
+    }
+    return;
+  }
+
+  // Open (tab sleeping): windowed browsers report the embedder's visibility
+  // too, so hidden pages are throttled and can be frozen or discarded.
+  // UpdateWebContentsVisibility, not WasShown()/WasHidden(): those leave the
+  // "first set visible" state unset, and the view's later visibility updates
+  // would then be ignored.
+  if (auto* web_contents = GetWebContents()) {
+    web_contents->UpdateWebContentsVisibility(
+        hidden ? content::Visibility::HIDDEN : content::Visibility::VISIBLE);
   }
 }
 
