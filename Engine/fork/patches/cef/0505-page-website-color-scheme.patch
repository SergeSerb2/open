+bool ChromeContentBrowserClientCef::OverrideWebPreferencesAfterNavigation(
+    content::WebContents* web_contents,
+    content::SiteInstance& main_frame_site,
+    blink::web_pref::WebPreferences* prefs) {
+  // Open (patch 0505): Chrome recomputes the color scheme after every
+  // navigation; the request context's website color scheme wins again.
+  const bool changed =
+      ChromeContentBrowserClient::OverrideWebPreferencesAfterNavigation(
+          web_contents, main_frame_site, prefs);
+#if BUILDFLAG(IS_MAC)
+  return open_engine::ApplyWebsiteColorScheme(web_contents, prefs) || changed;
+#else
+  return changed;
+#endif
 }
 
