diff --git a/cef/include/internal/cef_types.h b/cef/include/internal/cef_types.h
index 8c2c81fac..47e71be8c 100644
--- a/cef/include/internal/cef_types.h
+++ b/cef/include/internal/cef_types.h
@@ -754,6 +754,17 @@ typedef struct _cef_browser_settings_t {
   /// CefBrowserHost::SetAxViewportCollapse.
   ///
   cef_state_t ax_viewport_collapse;
+
+  ///
+  /// Open fork (tab sleeping): set to true (1) to create the browser's page
+  /// hidden and with no renderer process. Create it with an empty URL (a
+  /// CefTabStrip::CreateTab tab ignores the URL), then restore its history
+  /// with CefRestoreNavigationHistory before the page is shown; the current
+  /// entry loads on first show. Supported by Alloy style browsers and by
+  /// CefTabStrip::CreateTab; other Chrome style browsers ignore it. Only read
+  /// at creation.
+  ///
+  int no_renderer;
 #endif
 } cef_browser_settings_t;
 
