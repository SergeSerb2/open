 using content::BrowserThread;
 
@@ -208,11 +212,37 @@ void CefBrowserContext::Initialize() {
 
   iothread_state_ = base::MakeRefCounted<CefIOThreadState>();
   cookieable_schemes_ = MakeSupportedSchemes(settings_);
+
+  // Open: ad-block switches for the first (global) context, used by
+  // cefsimple until the CEF API lands (docs/plans/adblock-fork.md §13.1).
+  static bool open_adblock_switches_used = false;
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!open_adblock_switches_used &&
+      command_line->HasSwitch("open-adblock-dir")) {
+    open_adblock_switches_used = true;
+    const base::FilePath root =
+        command_line->GetSwitchValuePath("open-adblock-dir");
+    if (command_line->HasSwitch("open-adblock-selftest")) {
+      open_engine::RunOpenAdBlockSelftest(
+          open_adblock_service(), root,
+          base::BindOnce([](bool passed) { CefQuitMessageLoop(); }));
+    } else {
+      open_adblock_service()->SetEnabled(true);
+      open_adblock_service()->LoadFromDirectory(root, /*prefer_dat=*/true);
+    }
+  }
 }
 
 void CefBrowserContext::Shutdown() {
   CEF_REQUIRE_UIT();
 
+  // Open: stop ad blocking first; pending builds are dropped.
+  if (open_adblock_service_) {
+    open_adblock_service_->Shutdown();
+    open_adblock_service_.reset();
+  }
+
 #if DCHECK_IS_ON()
   is_shutdown_ = true;
 #endif
