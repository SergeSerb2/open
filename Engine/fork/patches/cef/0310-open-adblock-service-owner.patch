+void CefBrowserContext::ShutdownOpenAdBlockService() {
+  CEF_REQUIRE_UIT();
+  // Open: stop ad blocking first; pending builds are dropped, and the
+  // accessor creates no new service after this (review 100-6).
+  open_adblock_shut_down_ = true;
+  if (open_adblock_service_) {
+    open_adblock_service_->Shutdown();
+    open_adblock_service_.reset();
+  }
+}
+
+open_engine::OpenAdBlockService* CefBrowserContext::open_adblock_service() {
+  CEF_REQUIRE_UIT();
+  if (open_adblock_shut_down_) {
+    return nullptr;
+  }
+  if (!open_adblock_service_) {
+    open_adblock_service_ =
+        std::make_unique<open_engine::OpenAdBlockService>(cache_path_);
+    open_engine::ConfigureAdBlockRendererCache(this, open_adblock_service_.get());
+  }
+  return open_adblock_service_.get();
+}
