 void ChromeBrowserHostImpl::WasHidden(bool hidden) {
+#if BUILDFLAG(IS_MAC)
+  // Open: the embedder shows and hides hosted tabs, as a BrowserView does
+  // for its active tab.
+  if (open_engine::OpenTabStrip::IdForHost(this)) {
+    if (!CEF_CURRENTLY_ON_UIT()) {
+      CEF_POST_TASK(CEF_UIT, base::BindOnce(&ChromeBrowserHostImpl::WasHidden,
+                                            this, hidden));
