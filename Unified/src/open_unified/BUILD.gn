# GN graph of the Open Unified Browser: Chromium 156.0.8078.48 + Chromium
# Views chrome + Preact WebUI, with no CEF (Unified/PLAN.md §1).
#
# Layout inside the Chromium checkout (Unified/scripts/unified-apply):
#   //open_unified/            <- Unified/src/open_unified/
#   //open_unified/sources.gni <- generated by unified-apply (lists core/,
#                                 ui/design/ and ui/views/ sources, which
#                                 Tracks 2-5 own)
#   //open_unified/ui/webui/resources/ <- Unified/webui/dist/ (Vite + GRD)
#   //open/adblock/            <- Engine/fork/src/open/adblock/ (pure Chromium)
#
# Dependency shape (no cycles in deps; browser, Views UI, and WebUI live in
# open_unified_browser so they can share headers cleanly without violating
# Chromium's allow_circular_includes_from allowlist):
#
#   open_unified (group) -> open_unified_browser -> open_unified_core
#                                                -> open_unified_platform
#                                                -> open_unified_resources
#                                                -> //open/adblock
#   //open/adblock/renderer is linked into the renderer through
#   //chrome:dependencies (hook 0001) and wired by hook 0003.

import("//build/buildflag_header.gni")
import("//build/config/ui.gni")
import("//open_unified/open_unified.gni")
import("//open_unified/sources.gni")
import("//tools/grit/grit_rule.gni")

assert(!is_android && !is_ios && !is_chromeos && !is_fuchsia,
       "Open Unified targets Windows, Linux and macOS desktop only")

buildflag_header("buildflags") {
  header = "buildflags.h"
  flags = [
    "OPEN_UNIFIED_BROWSER=$open_unified_browser",
    "OPEN_ENABLE_AUTOMATION=$open_enable_automation",
  ]
}

# Shared settings for every Open source set.
config("open_unified_config") {
  # Chromium's own include root is //, so "open_unified/..." and
  # "open/adblock/..." resolve without extra include_dirs.
  defines = []
  if (open_enable_automation) {
    defines += [ "OPEN_ENABLE_AUTOMATION_SERVER=1" ]
  }
}

# ---------------------------------------------------------------------------
# Core (Tracks 2 and 3): BrowserModel, stores, sleep, routing, suggest,
# commands, sync, adblock KeyedService, boosts, documents, import.
# ---------------------------------------------------------------------------
source_set("open_unified_core") {
  sources = open_unified_core_sources
  configs += [ ":open_unified_config" ]
  public_deps = [
    ":buildflags",
    ":open_unified_platform",
    "//base",
    "//url",
  ]
  deps = [
    "//components/keyed_service/content",
    "//components/prefs",
    "//content/public/browser",
    "//crypto",
    "//net",
    "//open/adblock",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//sql",
    "//third_party/boringssl",
    "//third_party/sqlite",
    "//third_party/zlib/google:compression_utils",

    # OpenAdBlockProfileService clears renderer MemoryCaches after list
    # changes (WebCacheManager, Engine patch 0903).
    "//components/web_cache/browser",
  ]
}

# ---------------------------------------------------------------------------
# OS adapters (Track 3): exactly one platform file per target OS.
# ---------------------------------------------------------------------------
source_set("open_unified_platform") {
  sources = [
    "browser/platform/open_handoff.h",
    "browser/platform/open_platform.h",
  ]
  configs += [ ":open_unified_config" ]
  public_deps = [ "//url" ]
  deps = [
    "//base",
    "//ui/views",
  ]
  libs = []
  frameworks = []
  if (is_win) {
    sources += [
      "browser/platform/open_handoff_stub.cc",
      "browser/platform/open_platform_win.cc",
    ]
    deps += [ "//ui/base" ]
    libs += [
      "advapi32.lib",
      "crypt32.lib",
      "dwmapi.lib",
      "shell32.lib",
      "user32.lib",
    ]
  } else if (is_mac) {
    # Compiled with ARC (Chromium's default for .mm files).
    sources += [
      "browser/platform/open_handoff_mac.mm",
      "browser/platform/open_platform_mac.mm",
    ]
    deps += [ "//ui/gfx" ]  # native_ui_types.h (NSWindow of a views::Widget)
    frameworks += [
      "AppKit.framework",  # NSWindow, NSVisualEffectView, NSWorkspace
      "Carbon.framework",  # RegisterEventHotKey (global hotkeys)
      "CoreFoundation.framework",
      "Foundation.framework",
      "QuartzCore.framework",  # CALayer wash overlay for macOS vibrancy
      "Security.framework",  # SecItem* (Keychain)
      "SystemConfiguration.framework",  # SCDynamicStoreCopyComputerName
    ]
  } else if (is_linux) {
    sources += [
      "browser/platform/open_handoff_stub.cc",
      "browser/platform/open_platform_linux.cc",
    ]
    deps += [
      "//ui/linux:linux_ui",
      "//ui/ozone",
    ]
  }
}

# ---------------------------------------------------------------------------
# open:// WebUI: the Vite bundle as a GRIT pak.
# ---------------------------------------------------------------------------
grit("open_unified_resources") {
  # Generated by Unified/webui/scripts/gen-grd.mjs and copied by
  # unified-apply. Resource IDs: tools/gritsettings/resource_ids.spec entry
  # added by hook 0001.
  source = "$open_unified_webui_resources_dir/open_webui_resources.grd"
  outputs = [
    "grit/open_webui_resources.h",
    "grit/open_webui_resources_map.cc",
    "grit/open_webui_resources_map.h",
    "open_webui_resources.pak",
  ]
  output_dir = "$root_gen_dir/open_unified"

  # The Vite manifest is data, not a page; gen-grd.mjs lists it too.
  enable_input_discovery_for_gn_analyze = false
}

# ---------------------------------------------------------------------------
# Browser integration, Chromium Views chrome, and open:// WebUI C++ handlers.
# Kept in one source_set because Views/WebUI layers and OpenBrowserService
# mutually reference each other and Chromium restricts
# allow_circular_includes_from via //.gn.
# ---------------------------------------------------------------------------
