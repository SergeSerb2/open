    "//chrome/browser/ui/views/extensions:extension_popup",
    "//chrome/browser/ui/views/extensions:extensions_views_utils",
    "//chrome/browser/ui/views/frame:browser_view_header",
    "//chrome/browser/ui/views/frame:multi_contents_view",
    "//chrome/browser/ui/views/frame:top_container_view",
    "//chrome/common",
    "//components/content_settings/core/browser",
    "//components/content_settings/core/common",
    "//components/download/public/common:public",
    "//components/favicon/content",
    "//components/favicon/core",
    "//components/favicon_base",
    "//components/find_in_page",
    "//components/input",
    "//components/javascript_dialogs",
    "//components/keyed_service/content",
    "//components/language_detection/core",
    "//components/prefs",
    "//components/sessions",
    "//components/tabs:public",
    "//components/vector_icons",
    "//components/viz/common",
    "//components/web_cache/browser",
    "//components/web_modal",
    "//content/public/browser",
    "//content/public/common",
    "//extensions/browser",
    "//extensions/common",
    "//mojo/public/cpp/bindings",
    "//net",
    "//open/adblock",
    "//services/media_session/public/cpp",
    "//services/media_session/public/mojom",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//services/network/public/mojom:url_loader_base",
    "//services/service_manager/public/cpp",
    "//skia",
    "//third_party/blink/public/common",
    "//ui/accessibility",
    "//ui/base",
    "//ui/base/clipboard",
    "//ui/color",
    "//ui/compositor",
    "//ui/display",
    "//ui/events",
    "//ui/gfx",
    "//ui/gfx/animation",
    "//ui/gfx/codec",
