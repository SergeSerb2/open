    "//chrome/browser:certificate_viewer",
    "//chrome/browser:chrome_browser_main",
    "//chrome/browser:chrome_content_browser_client",
    "//chrome/browser/content_settings:content_settings_factory",
    "//chrome/browser/extensions",
    "//chrome/browser/favicon",
    "//chrome/browser/lifetime",
    "//chrome/browser/media/webrtc",
    "//chrome/browser/picture_in_picture",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/resource_coordinator",
    "//chrome/browser/translate",
    "//chrome/browser/ui",
    "//chrome/browser/ui:browser_commands",
    "//chrome/browser/ui:tab_helpers",
    "//chrome/browser/ui/browser_window:create_browser_window",
