# GN graph of the Open Unified Browser: Chromium 156.0.8078.48 + Chromium
# Views chrome + Preact WebUI, with no CEF (Unified/PLAN.md §1).
#
# Layout inside the Chromium checkout (Unified/scripts/unified-apply):
#   //open_unified/            <- Unified/src/open_unified/
#   //open_unified/sources.gni <- generated by unified-apply (lists core/,
#                                 ui/design/ and ui/views/ sources, which
#                                 Tracks 2-5 own)
#   //open_unified/ui/webui/resources/ <- Unified/webui/dist/ (Vite + GRD)
#   //open/adblock/            <- Engine/fork/src/open/adblock/ (pure Chromium)
#
# Dependency shape (no cycles in deps; allow_circular_includes_from lets the
# views and WebUI layers include OpenBrowserService headers):
#
#   open_unified (group) -> open_unified_browser -> open_unified_ui
#                                               -> open_unified_webui
#                                               -> open_unified_core
#                                                    -> //open/adblock
#   //open/adblock/renderer is linked into the renderer through
#   //chrome:dependencies (hook 0001) and wired by hook 0003.

import("//build/buildflag_header.gni")
import("//open_unified/open_unified.gni")
import("//open_unified/sources.gni")
import("//tools/grit/grit_rule.gni")

assert(!is_android && !is_ios && !is_chromeos && !is_fuchsia,
       "Open Unified targets Windows, Linux and macOS desktop only")

buildflag_header("buildflags") {
  header = "buildflags.h"
  flags = [
    "OPEN_UNIFIED_BROWSER=$open_unified_browser",
    "OPEN_ENABLE_AUTOMATION=$open_enable_automation",
  ]
}

# Shared settings for every Open source set.
config("open_unified_config") {
  # Chromium's own include root is //, so "open_unified/..." and
  # "open/adblock/..." resolve without extra include_dirs.
  defines = []
  if (open_enable_automation) {
    defines += [ "OPEN_ENABLE_AUTOMATION_SERVER=1" ]
  }
}

# ---------------------------------------------------------------------------
# Core (Tracks 2 and 3): BrowserModel, stores, sleep, routing, suggest,
# commands, sync, adblock KeyedService, boosts, documents, import.
# ---------------------------------------------------------------------------
source_set("open_unified_core") {
  sources = open_unified_core_sources
  configs += [ ":open_unified_config" ]
  public_deps = [
    ":buildflags",
    "//base",
    "//url",
  ]
  deps = [
    "//components/keyed_service/content",
    "//components/prefs",
    "//content/public/browser",
    "//crypto",
    "//net",
    "//open/adblock",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//sql",
    "//third_party/boringssl",
    "//third_party/sqlite",
    "//third_party/zlib/google:compression_utils",

    # OpenAdBlockProfileService clears renderer MemoryCaches after list
    # changes (WebCacheManager, Engine patch 0903).
    "//components/web_cache/browser",
  ]
}

# ---------------------------------------------------------------------------
# OS adapters (Track 3): exactly one platform file per target OS.
# ---------------------------------------------------------------------------
source_set("open_unified_platform") {
  sources = [ "browser/platform/open_platform.h" ]
  configs += [ ":open_unified_config" ]
  deps = [
    "//base",
    "//ui/views",
  ]
  libs = []
  frameworks = []
  if (is_win) {
    sources += [ "browser/platform/open_platform_win.cc" ]
    libs += [
      "advapi32.lib",
      "crypt32.lib",
      "dwmapi.lib",
      "shell32.lib",
      "user32.lib",
    ]
  } else if (is_mac) {
    sources += [ "browser/platform/open_platform_mac.mm" ]
    frameworks += [
      "AppKit.framework",
      "Carbon.framework",
      "Foundation.framework",
      "Security.framework",
    ]
  } else if (is_linux) {
    sources += [ "browser/platform/open_platform_linux.cc" ]
    deps += [ "//ui/ozone" ]
  }
}

# ---------------------------------------------------------------------------
# Chromium Views hot-path chrome (Tracks 4 and 5) and design system.
# ---------------------------------------------------------------------------
source_set("open_unified_ui") {
  sources = open_unified_ui_design_sources + open_unified_ui_views_sources
  configs += [ ":open_unified_config" ]
  public_deps = [ ":open_unified_core" ]
  deps = [
    ":open_unified_platform",
    "//cc/paint",
    "//chrome/app:command_ids",
    "//chrome/app/vector_icons",
    "//chrome/browser/ui",
    "//chrome/browser/ui/color:color_headers",
    "//components/favicon/content",
    "//components/vector_icons",
    "//content/public/browser",
    "//skia",
    "//third_party/blink/public/common:headers",
    "//ui/accessibility",
    "//ui/base",
    "//ui/color",
    "//ui/compositor",
    "//ui/events",
    "//ui/gfx",
    "//ui/gfx/animation",
    "//ui/gfx/geometry",
    "//ui/views",

    # views::WebView (Peek, Split panes, Little Open page) and
    # ui::SimpleMenuModel (sidebar, Split and Site Control menus) are
    # separate targets from //ui/views and //ui/base.
    "//ui/base/clipboard",
    "//ui/menus",
    "//ui/views/controls/webview",
  ]
  if (is_mac) {
    frameworks = [ "AppKit.framework" ]
  }
}

# ---------------------------------------------------------------------------
# open:// WebUI: the Vite bundle as a GRIT pak, and the C++ RPC handlers.
# ---------------------------------------------------------------------------
grit("open_unified_resources") {
  # Generated by Unified/webui/scripts/gen-grd.mjs and copied by
  # unified-apply. Resource IDs: tools/gritsettings/resource_ids.spec entry
  # added by hook 0001.
  source = "$open_unified_webui_resources_dir/open_webui_resources.grd"
  outputs = [
    "grit/open_webui_resources.h",
    "grit/open_webui_resources_map.cc",
    "grit/open_webui_resources_map.h",
    "open_webui_resources.pak",
  ]
  output_dir = "$root_gen_dir/open_unified"

  # The Vite manifest is data, not a page; gen-grd.mjs lists it too.
  enable_input_discovery_for_gn_analyze = false
}

source_set("open_unified_webui") {
  sources = [
    "ui/webui/open_documents_ui.cc",
    "ui/webui/open_documents_ui.h",
    "ui/webui/open_ipc_contract.h",
    "ui/webui/open_library_ui.cc",
    "ui/webui/open_library_ui.h",
    "ui/webui/open_boosts_ui.cc",
    "ui/webui/open_boosts_ui.h",
    "ui/webui/open_onboarding_ui.cc",
    "ui/webui/open_onboarding_ui.h",
    "ui/webui/open_settings_ui.cc",
    "ui/webui/open_settings_ui.h",
    "ui/webui/open_webui_config.cc",
    "ui/webui/open_webui_config.h",
  ]
  configs += [ ":open_unified_config" ]
  public_deps = [
    ":open_unified_core",
    ":open_unified_resources",
  ]
  deps = [
    ":open_unified_platform",
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui",
    "//chrome/common",
    "//components/keyed_service/content",
    "//content/public/browser",
    "//content/public/common",
    "//extensions/browser",
    "//services/network/public/mojom:url_loader_base",
    "//ui/base",
    "//ui/webui",
    "//url",
  ]
}

# ---------------------------------------------------------------------------
# Browser integration (Track 6): service, Chromium bridges, controllers,
# automation server, and the entry points the Chromium hooks call.
# ---------------------------------------------------------------------------
source_set("open_unified_browser") {
  sources = [
    "browser/open_boost_controller.cc",
    "browser/open_boost_controller.h",
    "browser/open_browser_main_extra_parts.cc",
    "browser/open_browser_main_extra_parts.h",
    "browser/open_browser_service.cc",
    "browser/open_browser_service.h",
    "browser/open_chromium_hooks.cc",
    "browser/open_chromium_hooks.h",
    "browser/open_extension_bridge.cc",
    "browser/open_extension_bridge.h",
    "browser/open_json.cc",
    "browser/open_json.h",
    "browser/open_model_util.cc",
    "browser/open_model_util.h",
    "browser/open_sleep_controller.cc",
    "browser/open_sleep_controller.h",
    "browser/open_switches.h",
    "browser/open_tab_bridge.cc",
    "browser/open_tab_bridge.h",
    "browser/open_window_controller.cc",
    "browser/open_window_controller.h",
  ]
  if (open_enable_automation) {
    sources += [
      "browser/open_automation_server.cc",
      "browser/open_automation_server.h",
    ]
  }
  configs += [ ":open_unified_config" ]
  public_deps = [
    ":buildflags",
    ":open_unified_core",
  ]
  deps = [
    ":open_unified_platform",
    ":open_unified_ui",
    ":open_unified_webui",
    "//base",
    "//chrome/browser",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/resource_coordinator",
    "//chrome/browser/ui",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/browser/ui/toolbar",
    "//chrome/common",
    "//components/content_settings/core/browser",
    "//components/content_settings/core/common",
    "//components/favicon/content",
    "//components/favicon/core",
    "//components/find_in_page",
    "//components/input",
    "//components/keyed_service/content",
    "//components/sessions",
    "//components/tabs:public",
    "//components/web_cache/browser",
    "//content/public/browser",
    "//content/public/common",
    "//extensions/browser",
    "//extensions/common",
    "//open/adblock",
    "//services/service_manager/public/cpp",
    "//skia",
    "//third_party/blink/public/common:headers",
    "//ui/base",
    "//ui/base/clipboard",
    "//ui/display",
    "//ui/events",
    "//ui/gfx",
    "//ui/menus",
    "//ui/native_theme",
    "//ui/snapshot",
    "//ui/views",
    "//ui/views/controls/webview",
    "//url",
  ]
  if (is_win) {
    libs = [ "ws2_32.lib" ]
  }

  # Views and WebUI handlers include OpenBrowserService and bridge headers;
  # they are linked into the same binary.
  allow_circular_includes_from = [
    ":open_unified_ui",
    ":open_unified_webui",
  ]
}

# Renderer side: Boost world bootstrap is browser-driven, so the renderer only
# needs the ad-block cosmetics agent (world 7, hook 0003).
group("open_unified_renderer") {
  public_deps = [
    "//open/adblock/mojom",
    "//open/adblock/renderer",
  ]
}

# ---------------------------------------------------------------------------
# Umbrella target linked into //chrome:dependencies by hook 0001.
# ---------------------------------------------------------------------------
group("open_unified") {
  if (open_unified_browser) {
    public_deps = [
      ":open_unified_browser",
      ":open_unified_renderer",
      ":open_unified_resources",
      "//open/adblock",
      "//open/adblock/renderer",
    ]
  }
}
