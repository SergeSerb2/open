    "browser/open_chromium_hooks.h",
    "browser/open_download_bridge.cc",
    "browser/open_download_bridge.h",
    "browser/open_extension_bridge.cc",
    "browser/open_extension_bridge.h",
    "browser/open_json.cc",
    "browser/open_json.h",
    "browser/open_media_bridge.cc",
    "browser/open_media_bridge.h",
    "browser/open_model_util.cc",
    "browser/open_model_util.h",
    "browser/open_sidebar_menus.cc",
    "browser/open_sidebar_menus.h",
    "browser/open_sleep_controller.cc",
    "browser/open_sleep_controller.h",
    "browser/open_switches.h",
    "browser/open_tab_bridge.cc",
    "browser/open_tab_bridge.h",
    "browser/open_translate_controller.cc",
    "browser/open_translate_controller.h",
    "browser/open_updater_service.cc",
    "browser/open_updater_service.h",
    "browser/open_window_controller.cc",
    "browser/open_window_controller.h",
    "ui/webui/open_boosts_ui.cc",
    "ui/webui/open_boosts_ui.h",
    "ui/webui/open_documents_ui.cc",
    "ui/webui/open_documents_ui.h",
    "ui/webui/open_ipc_contract.h",
    "ui/webui/open_library_ui.cc",
    "ui/webui/open_library_ui.h",
    "ui/webui/open_onboarding_ui.cc",
    "ui/webui/open_onboarding_ui.h",
    "ui/webui/open_settings_ui.cc",
    "ui/webui/open_settings_ui.h",
    "ui/webui/open_webui_config.cc",
    "ui/webui/open_webui_config.h",
  ] + open_unified_ui_design_sources + open_unified_ui_views_sources
  if (open_enable_automation) {
    sources += [
