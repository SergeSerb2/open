# Bundled AdBlock filter lists staged by unified-apply from Vendor/adblock/.
if (open_unified_has_adblock_resources) {
  if (is_mac) {
    bundle_data("open_unified_adblock_resources") {
      sources = [
        "adblock_resources/easylist.txt",
        "adblock_resources/easyprivacy.txt",
        "adblock_resources/resources.json",
      ]
      outputs = [ "{{bundle_resources_dir}}/adblock/{{source_file_part}}" ]
    }
  } else {
    copy("open_unified_adblock_resources") {
      sources = [
        "adblock_resources/easylist.txt",
        "adblock_resources/easyprivacy.txt",
        "adblock_resources/resources.json",
      ]
      outputs = [ "$root_out_dir/adblock_resources/{{source_file_part}}" ]
    }
  }
}

# Renderer side: Boost world bootstrap is browser-driven, so the renderer only
# needs the ad-block cosmetics agent (world 7, hook 0003).
group("open_unified_renderer") {
  public_deps = [
    "//open/adblock/mojom",
    "//open/adblock/renderer",
  ]
}

# ---------------------------------------------------------------------------
# Umbrella target linked into //chrome:dependencies by hook 0001.
# ---------------------------------------------------------------------------
group("open_unified") {
  if (open_unified_browser) {
    public_deps = [
      ":open_unified_browser",
      ":open_unified_renderer",
      ":open_unified_resources",
      "//open/adblock",
      "//open/adblock/renderer",
    ]
    if (open_unified_has_adblock_resources) {
      public_deps += [ ":open_unified_adblock_resources" ]
    }
  }
}
