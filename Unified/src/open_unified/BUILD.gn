    "browser/open_boost_controller.h",
    "browser/open_browser_main_extra_parts.cc",
    "browser/open_browser_main_extra_parts.h",
    "browser/open_browser_service.cc",
    "browser/open_browser_service.h",
    "browser/open_capture_controller.cc",
    "browser/open_capture_controller.h",
