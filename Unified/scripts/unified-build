#!/usr/bin/env bash
# Copyright 2026 The Open Authors. All rights reserved.
# Use of this source code is governed by a BSD-style license that can be
# found in the LICENSE file.
#
# Builds the Open Unified Browser from a checkout prepared by unified-apply.
#
#   unified-build --target linux-x64|win-x64|mac-arm64 [options] [ninja targets]
#
# Options:
#   --root DIR      checkout root (default ~/<UNIFIED_ROOT_DEFAULT>, VERSIONS)
#   --src DIR       Chromium src (default <root>/src)
#   --out DIR       output dir relative to src (default out/OpenLinux,
#                   out/OpenWin64, out/OpenMacArm64)
#   --remote        compile on the boat.dev NativeLink farm through Siso
#                   (needs `boat-farm.sh up` and `boat-farm.sh tunnel`)
#   --jobs N        local jobs (default: nproc; 4 with --remote)
#   --gn-arg K=V    extra GN arg (repeatable)
#   --gen-only      write args.gn and run `gn gen`, do not build
#   --check         also run `gn check` on //open_unified/*
#   --stage DIR     copy a runnable bundle to DIR (binary renamed to open /
#                   open.exe); win-x64 defaults to /mnt/c/Users/$USER/
#                   OpenUnified when /mnt/c exists
#
# Ninja targets default to `chrome` (the browser executable; hook 0001 links
# //open_unified into it).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
UNIFIED_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
# shellcheck source=/dev/null
source "${UNIFIED_DIR}/VERSIONS"

ROOT="${HOME}/${UNIFIED_ROOT_DEFAULT}"
SRC=""
TARGET=""
OUT=""
REMOTE=0
JOBS=""
GEN_ONLY=0
CHECK=0
STAGE=""
EXTRA_ARGS=()
NINJA_TARGETS=()

usage() {
  sed -n '6,25p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}
log() { printf '\033[1m[unified-build]\033[0m %s\n' "$*"; }
die() { printf '[unified-build] error: %s\n' "$*" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --root) ROOT="$2"; shift 2 ;;
    --src) SRC="$2"; shift 2 ;;
    --target) TARGET="$2"; shift 2 ;;
    --out) OUT="$2"; shift 2 ;;
    --remote) REMOTE=1; shift ;;
    --jobs) JOBS="$2"; shift 2 ;;
    --gn-arg) EXTRA_ARGS+=("$2"); shift 2 ;;
    --gen-only) GEN_ONLY=1; shift ;;
    --check) CHECK=1; shift ;;
    --stage) STAGE="$2"; shift 2 ;;
    -h|--help) usage 0 ;;
    -*) die "unknown option $1" ;;
    *) NINJA_TARGETS+=("$1"); shift ;;
  esac
done
SRC="${SRC:-${ROOT}/src}"
[[ ${#NINJA_TARGETS[@]} -gt 0 ]] || NINJA_TARGETS=(chrome)

case "${TARGET}" in
  linux-x64) ARGS_FILE=linux_x64.args.gn; OUT="${OUT:-out/OpenLinux}" ;;
  win-x64) ARGS_FILE=win_x64.args.gn; OUT="${OUT:-out/OpenWin64}" ;;
  mac-arm64) ARGS_FILE=mac_arm64.args.gn; OUT="${OUT:-out/OpenMacArm64}" ;;
  "") die "--target is required (linux-x64, win-x64, mac-arm64)" ;;
  *) die "unknown target ${TARGET}" ;;
esac

[[ -d "${SRC}/chrome" ]] || die "${SRC} is not a Chromium src directory"
grep -q 'open_unified hook 0001-dependencies' "${SRC}/chrome/BUILD.gn" ||
  die "hooks are not applied; run Unified/scripts/unified-apply first"
[[ -f "${SRC}/open_unified/sources.gni" ]] ||
  die "src/open_unified/sources.gni is missing; run unified-apply"

host_os="$(uname -s)"
if [[ "${TARGET}" == "mac-arm64" && "${host_os}" != "Darwin" ]]; then
  die "mac-arm64 builds need a macOS host (Xcode SDK)"
fi
if [[ "${host_os}" == "Darwin" && -x "${SRC}/third_party/cpython3/host/bin/python3" ]]; then
  # Avoid Apple's /usr/bin/python3 xcrun shim failing inside rustc -> linker_driver.py
  # when rustc_wrapper.py sets SDKROOT=sdk/xcode_links/MacOSX*.sdk.
  export PATH="${SRC}/third_party/cpython3/host/bin:${PATH}"
fi
if [[ "${TARGET}" == "win-x64" && "${host_os}" == "Linux" ]]; then
  # Linux -> Windows cross build: the packaged MSVC + Windows SDK sysroot
  # (Track 1's unified-win-toolchain) must be configured.
  [[ -n "${DEPOT_TOOLS_WIN_TOOLCHAIN_BASE_URL:-}${GYP_MSVS_HASH_OVERRIDE:-}" ||
     -d "${SRC}/third_party/depot_tools/win_toolchain/vs_files" ]] ||
    log "warning: no packaged Windows toolchain found; see unified-win-toolchain"
fi

command -v gn >/dev/null || die "gn not on PATH (add depot_tools)"

# --- args.gn -------------------------------------------------------------------
out_abs="${SRC}/${OUT}"
mkdir -p "${out_abs}"
args_tmp="$(mktemp)"
{
  printf '# Generated by Unified/scripts/unified-build (%s, Chromium %s).\n' \
    "${TARGET}" "${CHROMIUM_TAG}"
  printf '# Edit Unified/gn/*.args.gn instead.\n\n'
  cat "${UNIFIED_DIR}/gn/common.args.gn"
  printf '\n'
  cat "${UNIFIED_DIR}/gn/${ARGS_FILE}"
  if [[ "${REMOTE}" == 1 ]]; then
    printf '\n# Remote compile on the boat.dev NativeLink farm (Siso).\n'
    printf 'use_remoteexec = true\n'
    printf 'use_siso = true\n'
  fi
  if [[ ${#EXTRA_ARGS[@]} -gt 0 ]]; then
    printf '\n# --gn-arg\n'
    printf '%s\n' "${EXTRA_ARGS[@]}"
  fi
} > "${args_tmp}"
# Rewriting an identical args.gn would make gn regenerate every ninja file.
if ! cmp -s "${args_tmp}" "${out_abs}/args.gn"; then
  mv "${args_tmp}" "${out_abs}/args.gn"
  log "wrote ${OUT}/args.gn"
else
  rm -f "${args_tmp}"
fi

log "gn gen ${OUT}"
(cd "${SRC}" && gn gen "${OUT}")
if [[ "${CHECK}" == 1 ]]; then
  log "gn check //open_unified/*"
  (cd "${SRC}" && gn check "${OUT}" '//open_unified/*')
fi
[[ "${GEN_ONLY}" == 1 ]] && exit 0

# --- build -----------------------------------------------------------------------
started=$(date +%s)
if [[ "${REMOTE}" == 1 ]]; then
  (echo > /dev/tcp/127.0.0.1/50051) 2>/dev/null ||
    die "no farm tunnel on 127.0.0.1:50051 (run boat-farm.sh tunnel)"
  siso="${SRC}/third_party/siso/cipd/siso"
  [[ -x "${siso}" ]] || siso="$(command -v siso)" ||
    die "siso not found (depot_tools or third_party/siso)"
  log "siso ninja (remote) ${NINJA_TARGETS[*]}"
  (cd "${SRC}" && nice -n 10 "${siso}" ninja -C "${OUT}" \
     -project=open-unified -reapi_address=127.0.0.1:50051 -reapi_insecure \
     -reapi_instance=default_instance -reapi_grpc_conn_pool=8 \
     -reapi_grpc_data_conn_pool=8 -local_jobs="${JOBS:-4}" \
     -remote_jobs="${REMOTE_JOBS:-256}" -strict_remote "${NINJA_TARGETS[@]}")
else
  log "autoninja ${NINJA_TARGETS[*]}"
  jobs_args=()
  [[ -n "${JOBS}" ]] && jobs_args=(-j "${JOBS}")
  (cd "${SRC}" && nice -n 10 autoninja -C "${OUT}" "${jobs_args[@]}" \
     "${NINJA_TARGETS[@]}")
fi
log "built in $(( $(date +%s) - started )) s"

# --- stage -------------------------------------------------------------------------
if [[ -z "${STAGE}" && "${TARGET}" == "win-x64" && -d /mnt/c/Users ]]; then
  STAGE="/mnt/c/Users/${USER}/OpenUnified"
fi
[[ -n "${STAGE}" ]] || exit 0

log "stage -> ${STAGE}"
mkdir -p "${STAGE}"
case "${TARGET}" in
  linux-x64)
    for f in chrome chrome_crashpad_handler chrome_sandbox libEGL.so \
             libGLESv2.so libvk_swiftshader.so libvulkan.so.1 \
             vk_swiftshader_icd.json icudtl.dat resources.pak \
             chrome_100_percent.pak chrome_200_percent.pak \
             v8_context_snapshot.bin snapshot_blob.bin; do
      [[ -e "${out_abs}/${f}" ]] && cp -a "${out_abs}/${f}" "${STAGE}/"
    done
    cp -a "${out_abs}/locales" "${STAGE}/" 2>/dev/null || true
    if [[ -d "${out_abs}/adblock_resources" ]]; then
      rm -rf "${STAGE}/adblock_resources"
      cp -a "${out_abs}/adblock_resources" "${STAGE}/adblock_resources"
    else
      log "WARNING: ${out_abs}/adblock_resources is missing — staged build will lack bundled AdBlock lists (easylist.txt, easyprivacy.txt, resources.json)" >&2
    fi
    if [[ -f "${UNIFIED_DIR}/assets/linux/open-browser.desktop" ]]; then
      cp -a "${UNIFIED_DIR}/assets/linux/open-browser.desktop" "${STAGE}/open-browser.desktop"
    else
      log "WARNING: ${UNIFIED_DIR}/assets/linux/open-browser.desktop is missing" >&2
    fi
    if compgen -G "${UNIFIED_DIR}/assets/icons/linux/product_logo_*.png" >/dev/null; then
      mkdir -p "${STAGE}/icons"
      cp -a "${UNIFIED_DIR}/assets/icons/linux"/product_logo_*.png "${STAGE}/icons/"
    fi
    mv -f "${STAGE}/chrome" "${STAGE}/open"
    ;;
  win-x64)
    (cd "${out_abs}" && cp -a chrome.exe chrome.dll chrome_elf.dll \
       chrome_wer.dll *.pak icudtl.dat v8_context_snapshot.bin \
       libEGL.dll libGLESv2.dll vk_swiftshader.dll vk_swiftshader_icd.json \
       vulkan-1.dll d3dcompiler_47.dll dxcompiler.dll dxil.dll "${STAGE}/" \
       2>/dev/null || true)
    cp -a "${out_abs}/locales" "${STAGE}/" 2>/dev/null || true
    if [[ -d "${out_abs}/adblock_resources" ]]; then
      rm -rf "${STAGE}/adblock_resources"
      cp -a "${out_abs}/adblock_resources" "${STAGE}/adblock_resources"
    else
      log "WARNING: ${out_abs}/adblock_resources is missing — staged build will lack bundled AdBlock lists (easylist.txt, easyprivacy.txt, resources.json)" >&2
    fi
    # chrome.exe loads chrome.dll next to it; the exe name is free.
    mv -f "${STAGE}/chrome.exe" "${STAGE}/open.exe"
    # Missing-DLL guard (PLAN.md Milestone 1): every import must be staged
    # or a Windows system DLL.
    if command -v llvm-readobj >/dev/null; then
      llvm-readobj --coff-imports "${STAGE}/open.exe" "${STAGE}/chrome.dll" |
        awk '/Name:/ {print $2}' | sort -u > "${STAGE}/.imports.txt"
      log "imports listed in ${STAGE}/.imports.txt"
    fi
    ;;
  mac-arm64)
    app="$(find "${out_abs}" -maxdepth 1 -name '*.app' | head -1)"
    [[ -n "${app}" ]] || die "no .app in ${OUT}"
    cp -a "${app}" "${STAGE}/"
    ;;
esac
log "staged $(du -sh "${STAGE}" | cut -f1) in ${STAGE}"
