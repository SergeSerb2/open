+PRODUCT_FULLNAME=Open
+PRODUCT_SHORTNAME=Open
+PRODUCT_INSTALLER_FULLNAME=Open Installer
+PRODUCT_INSTALLER_SHORTNAME=Open Installer
+COPYRIGHT=Copyright @LASTCHANGE_YEAR@ The Open Authors. All rights reserved. Portions copyright The Chromium Authors.
+MAC_BUNDLE_ID=org.openbrowser.unified
 MAC_CREATOR_CODE=Cr24
