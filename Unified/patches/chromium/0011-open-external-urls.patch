   StartupTabs tabs = std::move(result.tabs);
+  // open_unified hook 0011-route-urls begin
+#if BUILDFLAG(OPEN_UNIFIED_BROWSER)
+  // Open's model is the session: URLs handed over by the OS go
+  // through Air Traffic Control (a Space or Little Open). At
+  // process startup Chromium still opens its startup window
+  // (Open adopts it); a later launch opens nothing.
+  if (result.launch_result == LaunchResult::kWithGivenUrls) {
+    std::vector<GURL> open_urls;
+    for (const StartupTab& tab : tabs) {
+      open_urls.push_back(tab.url);
+    }
+    if (open_unified::hooks::RouteExternalUrls(profile_, open_urls)) {
+      if (process_startup == chrome::startup::IsProcessStartup::kNo) {
+        return;
+      }
+      tabs = StartupTabs({StartupTab(chrome::ChromeUINewTabURLAsGURL())});
+      result.launch_result = LaunchResult::kNormally;
+    }
+  }
+#endif
+  // open_unified hook 0011-route-urls end
 
